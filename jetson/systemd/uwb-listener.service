[Unit]
Description=UWB Ranging Active Listener (DWM3001CDK tag on ttyACM0)
After=multi-user.target

[Service]
Type=simple
User=__USER__
ExecStart=/usr/bin/python3 __HOME__/simrank/jetson/uwb_listener.py
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
